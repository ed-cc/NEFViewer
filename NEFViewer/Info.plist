<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>NEFViewer</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Export com.nikon.raw-image so this app is the authoritative owner of
	     the UTI. Using UTExportedTypeDeclarations (not Imported) causes macOS
	     Launch Services to prefer this app's Quick Look extensions over the
	     system-default RAW codec handler when resolving .nef files. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.nikon.raw-image</string>
			<key>UTTypeDescription</key>
			<string>Nikon NEF Raw Image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.raw-image</string>
				<string>public.image</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nef</string>
					<string>NEF</string>
				</array>
				<key>public.mime-type</key>
				<string>image/x-nikon-nef</string>
			</dict>
		</dict>
	</array>
	<!-- Register NEF as an openable document type so Launch Services builds
	     the full app→UTI association needed for QL extension dispatch. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Nikon NEF Raw Image</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.nikon.raw-image</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
</dict>
</plist>
